# =====================================================================
#  Client Management Portal - API settings
#  The API is the only part that talks to SQL Server and holds the keys.
#  After changes: run restart-service.cmd as administrator
#  (or close and re-open start.cmd).
# =====================================================================

# --- Database (required) ---------------------------------------------
# Microsoft SQL Server connection.
#   Server=HOST              default instance, port 1433
#   Server=HOST,1444         custom port
#   Server=HOST\SQLEXPRESS   named instance (needs the "SQL Server Browser" service)
DATABASE_URL="Server=localhost;Database=client_management_db;User Id=app_user;Password=CHANGE-ME;TrustServerCertificate=true;Encrypt=false"

# --- Network ------------------------------------------------------------
# Port the API listens on.
PORT=4000
# 127.0.0.1 = only programs on THIS machine can reach the API (safest; use this when
#             the application folder runs on the same machine).
# 0.0.0.0   = reachable from the network (use this only when the application runs on
#             another machine; install-service.cmd then opens the firewall port).
HOST=127.0.0.1

# --- Security -----------------------------------------------------------
# Leave these as they are on the first start: they are replaced with random
# values automatically and saved here.
# AFTER THAT: back up ENCRYPTION_SECRET (password manager). If it is lost or
# changed, saved vault passwords can no longer be read.
AUTH_SECRET="generate-on-first-start"
ENCRYPTION_SECRET="generate-on-first-start"

# Login cookie "Secure" flag. Leave empty = automatic. Set true only when users open
# the application over HTTPS (e.g. behind IIS/nginx with a certificate).
COOKIE_SECURE=
