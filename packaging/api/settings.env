# =====================================================================
#  Client Management Portal - API settings
#  After editing: restart this site in IIS Manager (or recycle its app pool).
# =====================================================================

# Microsoft SQL Server connection (required)
#   Server=HOST              default instance, port 1433
#   Server=HOST,1444         custom port
#   Server=HOST\SQLEXPRESS   named instance (needs the "SQL Server Browser" service)
DATABASE_URL="Server=localhost;Database=client_management_db;User Id=app_user;Password=CHANGE-ME;TrustServerCertificate=true;Encrypt=false"

# Security keys - already generated for you. BACK UP THIS FILE.
# Never change ENCRYPTION_SECRET after passwords are saved in the vault:
# they could no longer be read.
AUTH_SECRET="generate-on-first-start"
ENCRYPTION_SECRET="generate-on-first-start"

# Login cookie "Secure" flag. Leave empty = automatic (on when the application
# site is opened over https://). Set true to force it.
COOKIE_SECURE=
