<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Client Management Portal ({{PART}}).
  IIS starts runtime\node.exe bin\launch.js through the ASP.NET Core Module V2
  (installed with the ".NET Hosting Bundle") and forwards every request to it.
  Settings are in settings.env, not here.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath=".\runtime\node.exe"
                arguments=".\bin\launch.js"
                hostingModel="outofprocess"
                startupTimeLimit="120"
                requestTimeout="00:05:00"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </aspNetCore>

    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- never serve these folders/files over the web -->
        <hiddenSegments>
          <add segment="settings.env" />
          <add segment="runtime" />
          <add segment="logs" />
        </hiddenSegments>
        <!-- backups can be large -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
