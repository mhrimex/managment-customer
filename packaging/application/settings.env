# =====================================================================
#  Client Management Portal - Application (website) settings
#  After editing: restart this site in IIS Manager (or recycle its app pool).
# =====================================================================

# Address of the API site in IIS (its binding).
#   Same server, API site bound to port 4000:   http://127.0.0.1:4000
#   API on another server:                      http://<api-server>:4000
API_URL=http://127.0.0.1:4000
