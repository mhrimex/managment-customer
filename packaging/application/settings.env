# =====================================================================
#  Client Management Portal - Application (website) settings
#  After changes: run restart-service.cmd as administrator
#  (or close and re-open start.cmd).
# =====================================================================

# Port the website listens on. Users open http://<this-machine>:PORT
PORT=3000

# Where the API is running (the api folder's PORT / machine).
#   Same machine:     http://127.0.0.1:4000
#   Other machine:    http://<api-machine-ip>:4000   (set HOST=0.0.0.0 in the api settings)
# Browsers never connect to the API directly; the website forwards their requests.
API_URL=http://127.0.0.1:4000
