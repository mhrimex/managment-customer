# =====================================================================
#  Client Management Portal - Application (website) settings
#  After editing: restart this site in IIS Manager (or recycle its app pool).
# =====================================================================

# Address of the API site = the IIS binding YOU gave the API site.
#   Example, same server, API site bound to 127.0.0.1 port 5050:  http://127.0.0.1:5050
#   Example, API on another server, port 5050:                     http://<api-server>:5050
# (The website's own port is simply its IIS binding - nothing to set here.)
API_URL=http://127.0.0.1:4000
