# =====================================================================
# Client & Solutions Management System - Environment Variables
# =====================================================================

# Microsoft SQL Server Connection String
# Option 1 (Standard connection string):
DATABASE_URL="Server=localhost;Database=client_management_db;User Id=sa;Password=YourPassword123!;TrustServerCertificate=true;Encrypt=false"

# Option 2 (URL style):
# DATABASE_URL="mssql://sa:YourPassword123!@localhost:1433/client_management_db?encrypt=false&trustServerCertificate=true"

# Server Port (default 3000)
PORT=3000

# Application Environment
NODE_ENV=development

# Secret used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional branding
# NEXT_PUBLIC_COMPANY_NAME="Reflection Solutions"
# NEXT_PUBLIC_COMPANY_LOGO="/logo.svg"

# Show one-click demo role buttons on the login page (development only)
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# Key that encrypts vault passwords. Generate once, back it up, never change it after storing secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ENCRYPTION_SECRET="change-me-to-a-long-random-string"
