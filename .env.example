# =====================================================================
# Client & Solutions Management System - configuration
# Copy to .env (scripts\deploy.ps1 does this for you and fills the secrets).
# After changing anything here: restart the app (run scripts\deploy.ps1 again).
# NEXT_PUBLIC_* values are baked in at build time -> they need a rebuild (deploy.ps1 does it).
# =====================================================================

# --- Database (required) ---------------------------------------------
# Microsoft SQL Server. Use a dedicated login, not "sa", in production.
#   Server=HOST            default instance on port 1433
#   Server=HOST,1444       custom port
#   Server=HOST\SQLEXPRESS named instance (needs the SQL Browser service)
DATABASE_URL="Server=localhost;Database=client_management_db;User Id=app_user;Password=YourStrongPassword!;TrustServerCertificate=true;Encrypt=false"
# URL style also works:
# DATABASE_URL="mssql://app_user:YourStrongPassword!@localhost:1433/client_management_db?encrypt=false&trustServerCertificate=true"

# --- Web server -------------------------------------------------------
# Port the app listens on (http://<this-pc>:PORT)
PORT=3000

# Do NOT set NODE_ENV here; npm sets it (development for "npm run dev", production for builds).
# NODE_ENV=production

# --- Security (required) ----------------------------------------------
# Signs login sessions. Changing it logs everybody out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Encrypts vault passwords. Generate once (same command), BACK IT UP,
# and never change it after storing secrets -> they would become unreadable.
ENCRYPTION_SECRET="change-me-to-a-long-random-string"

# Login cookie "Secure" flag. Leave unset = automatic (on for HTTPS, off for plain http://IP:PORT).
# COOKIE_SECURE=true

# --- Branding (optional, needs rebuild) -------------------------------
# NEXT_PUBLIC_COMPANY_NAME="Reflection Solutions"
# NEXT_PUBLIC_COMPANY_LOGO="/logo.svg"      # put your file in the public\ folder

# Show one-click demo login buttons on the login page (never in real use)
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=true
